\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Resolved semantic region typing for the Rainier capture, overlaid on the panorama. Vegetation, bare terrain, snow and standing water separate cleanly in the near field. The typing is run twice, once on the original panorama and once on the cleaned one, because the two answer different questions: where ground cover should be scattered is a property of the scene as photographed, while what the terrain surface is made of is a property of the scene with the objects taken away.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:rainier-regions}{{5}{12}{Resolved semantic region typing for the Rainier capture, overlaid on the panorama. Vegetation, bare terrain, snow and standing water separate cleanly in the near field. The typing is run twice, once on the original panorama and once on the cleaned one, because the two answer different questions: where ground cover should be scattered is a property of the scene as photographed, while what the terrain surface is made of is a property of the scene with the objects taken away}{figure.caption.11}{}}
\newlabel{fig:rainier-regions@cref}{{[figure][5][]5}{[1][11][]12}{}{}{}}
